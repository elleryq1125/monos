<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.monos.mapper.CompanyMapper">
  <!-- 結果と結果を受け取るクラスの紐づけ -->
  <resultMap id="companyResultMap" type="com.example.monos.domain.Company">
    <result property="companyId" column="company_id" />
    <result property="name" column="name"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>
  <!-- SQL -->  
  <insert id="insert" parameterType="com.example.monos.domain.Company" useGeneratedKeys="true" keyProperty="companyId">
		INSERT INTO companies(name) VALUES (#{name});
	</insert>
</mapper>