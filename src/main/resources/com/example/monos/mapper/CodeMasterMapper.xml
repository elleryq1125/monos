<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.monos.mapper.CodeMasterMapper">
  <!-- SQL -->  
	  <select id="selectListByCodeType" resultType="com.example.monos.domain.CodeMaster">
			SELECT 
				code_type
				,code
				,name
				,created_at
				,updated_at
			FROM 
				code_masters
			WHERE
				code_type = #{codeType}
			ORDER BY
				display_order;
		</select>
</mapper>